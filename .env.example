# ─────────────────────────────────────────────────────────────
# 这是模板文件，供 cp .env.example .env 后填入自己的值。
# 程序只读取 .env，不会读取本文件（load_dotenv 默认只认 .env）。
# ⚠️ 切勿把真实 token 写进本文件 —— 它会被提交进仓库、公开可见！
# ─────────────────────────────────────────────────────────────

# 数据库路径（默认：data/sequoia_v2.db）
DB_PATH=data/sequoia_v2.db

# 数据起始日期（默认：2024-01-01）
START_DATE=2024-01-01

# PushPlus Token（必填，全局默认推送 token）
# 获取地址：https://www.pushplus.plus/push1.html
PUSHPLUS_TOKEN=your-pushplus-token-here

# 策略专属推送 Token（可选，格式：STRATEGY_WEBHOOK_<策略标识>=<token>）
# 未配置的策略将自动使用全局 PUSHPLUS_TOKEN
# STRATEGY_WEBHOOK_MA_VOLUME=your-ma-volume-token
# STRATEGY_WEBHOOK_TURTLE=your-turtle-token
# STRATEGY_WEBHOOK_FLAG=your-flag-token
# STRATEGY_WEBHOOK_SHAKEOUT=your-shakeout-token
# STRATEGY_WEBHOOK_LIMIT_DOWN=your-limit-down-token
# STRATEGY_WEBHOOK_RPS=your-rps-token
# STRATEGY_WEBHOOK_PRIVATE_PLACEMENT=your-private-placement-token
